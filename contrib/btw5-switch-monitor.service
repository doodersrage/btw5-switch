# The background service's name before btw5-switch was renamed btwctl (0.7).
# Kept so a service enabled under the old name keeps working after the upgrade.
# New setups: systemctl --user enable --now btwctl-monitor.service
# (The settings window's "Start background service" button switches over.)
[Unit]
Description=Creative BT-W dongle event monitor (old name; see btwctl-monitor.service)
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=btwctl-monitor.service

[Service]
ExecStart=/bin/sh -c 'PATH="$$HOME/.local/bin:$$PATH" exec btwctl monitor --notify'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
