# Desktop notifications for BT-W5 headset/setting changes.
# Enable with:  systemctl --user enable --now btw5-switch-monitor.service
# While it runs, other btw5-switch commands talk to the dongle through it.
[Unit]
Description=Creative BT-W5 event monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/btw5-switch monitor --notify
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
