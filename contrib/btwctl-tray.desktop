[Desktop Entry]
Type=Application
Name=BT-W Control (tray icon)
GenericName=Bluetooth audio dongle control
Comment=Tray icon for the Creative BT-W5: aptX mode, HFP and headset switching
Exec=btwctl tray
Icon=audio-headphones
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=bluetooth;aptx;headset;creative;
X-GNOME-Autostart-enabled=true
