[Desktop Entry]
Type=Application
Name=BT-W5 Switch
GenericName=Bluetooth audio dongle settings
Comment=Settings for the Creative BT-W5 and BT-W6: aptX mode, headset microphone, pairing
Exec=btw5-switch gui
Icon=audio-headphones
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=bluetooth;aptx;headset;creative;pairing;
StartupNotify=true
Actions=low-latency;high-quality;toggle;tray;

[Desktop Action low-latency]
Name=aptX Low Latency
Exec=btw5-switch --notify ll

[Desktop Action high-quality]
Name=aptX High Quality
Exec=btw5-switch --notify hq

[Desktop Action toggle]
Name=Toggle Low Latency / High Quality
Exec=btw5-switch --notify toggle

[Desktop Action tray]
Name=Show tray icon
Exec=btw5-switch tray
